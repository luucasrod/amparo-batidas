# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (produção). Na Vercel podes usar o domínio .vercel.app ou o teu domínio.
SITE_URL=https://amparo-batidas.vercel.app

# Stripe (Developers → API keys + Webhooks)
STRIPE_SECRET_KEY=sk_live_or_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Easypay (Documentação: https://docs.easypay.pt/)
EASYPAY_BASE_URL=https://api.test.easypay.pt/2.0
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
# ID da conta de captura (por vezes igual ao account; confirma no backoffice Easypay)
EASYPAY_CAPTURE_ACCOUNT_ID=

# Token secreto para /admin.html chamar /api/admin-orders (escolhe uma string longa)
ADMIN_TOKEN=
